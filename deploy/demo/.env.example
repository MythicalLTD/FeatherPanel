# Optional — defaults work for local. On the public demo VM use single-level
# Cloudflare hostnames (Universal SSL does not cover *.demo.featherpanel.com):
#   FEATHERPANEL_APP_URL=https://demo.featherpanel.com
#   DEMO_WINGS_FQDN=wings-demo.featherpanel.com
#   DEMO_QUILL_FQDN=quill-demo.featherpanel.com
# Non-localhost FQDNs auto-set scheme=https + behind_proxy=1 so the browser
# uses wss://host (Cloudflare :443), not ws://host:8081.
#
#   docker compose up -d

FEATHERPANEL_APP_URL=http://localhost:8088
FEATHERPANEL_PANEL_PORT=8088
FEATHERPANEL_MCP_PORT=3001

DEMO_WINGS_REMOTE_URL=http://backend:80

DEMO_WINGS_FQDN=localhost
# DEMO_WINGS_SCHEME=https
# DEMO_WINGS_BEHIND_PROXY=1
DEMO_WINGS_DAEMON_PORT=8081
DEMO_WINGS_SFTP_PORT=2022
DEMO_WINGS_SFTP_HOST_PORT=22022

DEMO_QUILL_FQDN=localhost
# DEMO_QUILL_SCHEME=https
# DEMO_QUILL_BEHIND_PROXY=1
DEMO_QUILL_DAEMON_PORT=8989
DEMO_QUILL_SFTP_PORT=2222

DEMO_WINGS_DOCKER_NETWORK=featherpanel_nw
DEMO_WINGS_DOCKER_SUBNET=172.19.0.0/16
DEMO_WINGS_DOCKER_GATEWAY=172.19.0.1
DEMO_WINGS_UID=988
DEMO_WINGS_GID=988

DEMO_WINGS_ROOT_PATH=/var/lib/featherpanel-demo
DEMO_WINGS_TMP_PATH=/tmp/featherpanel-demo-wings
DEMO_QUILL_ROOT_PATH=/var/lib/featherquilld-demo
DEMO_QUILL_TMP_PATH=/tmp/featherquilld-demo

DEMO_ALLOCATION_IP=0.0.0.0
DEMO_ALLOCATION_IP_ALIAS=localhost
DEMO_ALLOCATION_PORT_START=25565
DEMO_ALLOCATION_PORT_END=25584

# Auto reset (DB) + auto update (images)
DEMO_RESET_INTERVAL_SECONDS=1800
DEMO_UPDATE_INTERVAL_SECONDS=3600
DEMO_REBUILD_GOLDEN=0

# --- Demo credentials (login with email or username) ---
# Account 1 (Admin)
DEMO_USER_USERNAME=demo
DEMO_USER_EMAIL=demo@demo.demo
DEMO_USER_PASSWORD=demoPassword
# Account 2 (Admin)
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin@featherpanel.com
DEMO_ADMIN_PASSWORD=admin@featherpanel.com

DEMO_SUPPORT_USERNAME=support
DEMO_SUPPORT_PASSWORD=demoPassword
DEMO_MOD_USERNAME=moderator
DEMO_MOD_PASSWORD=demoPassword

MARIADB_ROOT_PASSWORD=featherpanel_demo_root
MARIADB_DATABASE=featherpanel
MARIADB_USER=featherpanel
MARIADB_PASSWORD=featherpanel_demo_password
REDIS_PASSWORD=featherpanel_demo_redis
