  // Syntax token colors layered on top of the base theme
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": {
          "foreground": "#64748b",
          "fontStyle": "italic"
        }
      },
      {
        "scope": ["string", "string.quoted", "string.template"],
        "settings": {
          "foreground": "#86efac"
        }
      },
      {
        "scope": ["constant.numeric", "constant.language"],
        "settings": {
          "foreground": "#fde68a"
        }
      },
      {
        "scope": ["keyword", "storage.type", "storage.modifier"],
        "settings": {
          "foreground": "#f0abfc"
        }
      },
      {
        "scope": ["entity.name.function", "support.function"],
        "settings": {
          "foreground": "#93c5fd"
        }
      },
      {
        "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
        "settings": {
          "foreground": "#67e8f9"
        }
      },
      {
        "scope": ["variable", "variable.other", "variable.parameter"],
        "settings": {
          "foreground": "#e6e6f0"
        }
      },
      {
        "scope": ["entity.name.tag", "meta.tag"],
        "settings": {
          "foreground": "#c084fc"
        }
      },
      {
        "scope": ["entity.other.attribute-name"],
        "settings": {
          "foreground": "#fde68a"
        }
      },
      {
        "scope": ["constant.character.escape"],
        "settings": {
          "foreground": "#f0abfc"
        }
      },
      {
        "scope": ["markup.heading"],
        "settings": {
          "foreground": "#c084fc",
          "fontStyle": "bold"
        }
      },
      {
        "scope": ["markup.bold"],
        "settings": {
          "fontStyle": "bold",
          "foreground": "#f8fafc"
        }
      },
      {
        "scope": ["markup.italic"],
        "settings": {
          "fontStyle": "italic",
          "foreground": "#f0abfc"
        }
      },
      {
        "scope": ["markup.inline.raw", "markup.fenced_code"],
        "settings": {
          "foreground": "#86efac",
          "background": "#161024"
        }
      },
      {
        "scope": ["invalid", "invalid.illegal"],
        "settings": {
          "foreground": "#f87171",
          "fontStyle": "underline"
        }
      },
      {
        "scope": ["support.constant", "constant.other"],
        "settings": {
          "foreground": "#fde68a"
        }
      },
      {
        "scope": ["punctuation", "meta.brace"],
        "settings": {
          "foreground": "#94a3b8"
        }
      },
      {
        "scope": ["entity.name.namespace"],
        "settings": {
          "foreground": "#c084fc"
        }
      },
      {
        "scope": ["variable.language.this", "variable.language.self"],
        "settings": {
          "foreground": "#f0abfc",
          "fontStyle": "italic"
        }
      }
    ]
  },

  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "function": "#93c5fd",
      "method": "#93c5fd",
      "function.declaration": {
        "foreground": "#93c5fd",
        "fontStyle": "bold"
      },
      "class": "#67e8f9",
      "interface": "#67e8f9",
      "enum": "#67e8f9",
      "type": "#67e8f9",
      "typeParameter": "#f0abfc",
      "namespace": "#c084fc",
      "variable": "#e6e6f0",
      "variable.readonly": "#fde68a",
      "parameter": "#cbd5e1",
      "property": "#93c5fd",
      "enumMember": "#fde68a",
      "keyword": "#f0abfc",
      "string": "#86efac",
      "number": "#fde68a",
      "comment": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      },
      "macro": "#c084fc",
      "*.deprecated": {
        "foreground": "#64748b",
        "fontStyle": "strikethrough"
      },
      "*.async": {
        "foreground": "#f0abfc",
        "fontStyle": "italic"
      },
      "*.readonly": "#fde68a",
      "*.declaration": {
        "fontStyle": "bold"
      }
    }
  },

  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "FIXME",
    "TODO",
    "[ ]",
    "[x]",
    "REFACTOR"
  ],
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "iconColour": "#a855f7",
      "foreground": "#f0abfc"
    },
    "FIXME": {
      "iconColour": "#ef4444",
      "foreground": "#fca5a5"
    },
    "BUG": {
      "iconColour": "#f87171",
      "foreground": "#fecaca"
    },
    "HACK": {
      "iconColour": "#eab308",
      "foreground": "#fde68a"
    },
    "REFACTOR": {
      "iconColour": "#60a5fa",
      "foreground": "#93c5fd"
    }
  },

  "php.version": "8.5",
  "php.stubs": ["*", "opcache"],
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnPaste": true, // required
  "editor.formatOnType": false, // required
  "editor.formatOnSave": true, // optional
  "editor.formatOnSaveMode": "file",
  "php-cs-fixer.executablePath": "/var/www/featherpanel/backend/storage/packages/bin/php-cs-fixer",
