# Copy to team.env and share with colleagues (gitignore team.env if you want).
# Source before patching or starting the editor:
#   set -a && source dev/team.env && set +a

# Your machine running the mock / real dev license server (LAN IP or 127.0.0.1)
DEVSENSE_LICENSE_API=http://127.0.0.1:3847/license/

# Mock server bind (0.0.0.0 = teammates can reach your machine on the LAN)
HOST=0.0.0.0
PORT=3847

# Optional: license JSON for language server when not using the patch (usually not needed)
# DEVSENSE_PHP_LS_LICENSE={"name":"dev","license":"premium","expiration":"2099-12-31T23:59:59.000Z","signature":"dev-bypass"}
