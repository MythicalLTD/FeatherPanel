+        return ApiResponse::success([
+            'schedules' => array_map([self::class, 'serializeSchedule'], VmSchedule::forInstance($id)),
+            'features' => self::scheduleFeatures(),
+            'timezone' => date_default_timezone_get(),
+        ], 'Schedules fetched', 200);
