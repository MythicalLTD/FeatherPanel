+            $userId = (int) ($row['user_id'] ?? 0);
+            if ($userId <= 0 || isset($users[$userId])) {
+                continue;
+            }
+            $permissions = json_decode((string) ($row['permissions'] ?? ''), true);
+            if (!is_array($permissions) || !in_array($permission, $permissions, true)) {
