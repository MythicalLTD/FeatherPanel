+        }
+        if (count($existing) + count($todo) > self::maxRules()) {
+            return ApiResponse::error('Firewall rule limit reached (' . self::maxRules() . ')', 'RULE_LIMIT_REACHED', 409);
+        }
+        foreach ($todo as $rule) {
