+by the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+See the LICENSE file or <https://www.gnu.org/licenses/>.
+*/
+
+'use client';
+
+import { useEffect, useState } from 'react';
+import axios from 'axios';
+
+export type VdsTimeframe = 'hour' | 'day' | 'week' | 'month' | 'year';
+
+/** Admin-controlled VDS feature flags and limits (GET /api/user/vm-instances/{id}/features). */
+export interface VdsFeatures {
+    graphs: { enabled: boolean; timeframes: VdsTimeframe[] };
+    console: {
+        paste_enabled: boolean;
+        paste_max_chars: number;
+        screenshot_enabled: boolean;
+        ctrl_alt_del_enabled: boolean;
+        brand_name: string;
+        brand_logo: string;
+    };
+    iso: {
+        enabled: boolean;
+        mode: 'provider' | 'provider_user' | 'disabled';
+        user_isos: boolean;
+        upload_enabled: boolean;
+        url_enabled: boolean;
+        max_size_mb: number;
+        max_per_user: number;
+        require_approval: boolean;
+        url_domains: string[];
+        can_upload: boolean;
+    };
+    rescue: { enabled: boolean };
+    snapshots: { enabled: boolean; limit: number; include_ram_allowed: boolean };
+    firewall: { enabled: boolean; max_rules: number; allow_policy: boolean; presets: string[] };
+    schedules: { enabled: boolean; max: number; actions: string[]; allow_hourly: boolean; max_keep: number };
+    reauth: { mode: 'off' | 'password' | '2fa_or_password'; actions: string[]; method: 'password' | '2fa' | null };
+    bandwidth: { enabled: boolean };
+}
+
+const cache = new Map<number, VdsFeatures>();
+
+export function useVdsFeatures(id: number | null | undefined): VdsFeatures | null {
+    const [features, setFeatures] = useState<VdsFeatures | null>(() => (id ? (cache.get(id) ?? null) : null));
+    useEffect(() => {
+        if (!id) return;
+        let cancelled = false;
+        axios
+            .get(`/api/user/vm-instances/${id}/features`)
+            .then(({ data }) => {
+                if (cancelled || !data?.success) return;
+                cache.set(id, data.data as VdsFeatures);
+                setFeatures(data.data as VdsFeatures);
+            })
+            .catch(() => {
+                // Leave features null: optional extras stay hidden.
+            });
+        return () => {
+            cancelled = true;
+        };
+    }, [id]);
+    return features;
+}
diff --git a/frontendv2/src/lib/vnc/usKeymap.ts b/frontendv2/src/lib/vnc/usKeymap.ts
new file mode 100644
index 00000000..7f2fd025
--- /dev/null
+++ b/frontendv2/src/lib/vnc/usKeymap.ts
@@ -0,0 +1,92 @@
+/*
+This file is part of FeatherPanel.
+
+Copyright (C) 2025 MythicalSystems Studios
+Copyright (C) 2025 FeatherPanel Contributors
+Copyright (C) 2025 Cassian Gherman (aka NaysKutzu)
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU Affero General Public License as published
+by the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+See the LICENSE file or <https://www.gnu.org/licenses/>.
+*/
+
+/**
+ * Character → physical key (KeyboardEvent.code) on a US QWERTY layout, plus whether Shift is held.
+ *
+ * Proxmox/QEMU VNC supports the QEMU "extended key event", where noVNC sends the hardware scancode
+ * derived from `code`. The guest then turns the scancode into a character with its own keymap, so
+ * sending the right physical key + Shift is what makes typed text reliable, independent of the
+ * browser's keyboard layout. This assumes the guest uses a US layout (the default for most
+ * cloud images and installers). Characters outside this map fall back to a keysym-only event.
+ */
+export interface KeyStroke {
+    keysym: number;
+    code: string;
+    shift: boolean;
+}
+
+const ROWS: Array<[string, string, string]> = [
+    // [unshifted, shifted, code]
+    ['`', '~', 'Backquote'],
+    ['1', '!', 'Digit1'],
+    ['2', '@', 'Digit2'],
+    ['3', '#', 'Digit3'],
+    ['4', '$', 'Digit4'],
+    ['5', '%', 'Digit5'],
+    ['6', '^', 'Digit6'],
+    ['7', '&', 'Digit7'],
+    ['8', '*', 'Digit8'],
+    ['9', '(', 'Digit9'],
+    ['0', ')', 'Digit0'],
+    ['-', '_', 'Minus'],
+    ['=', '+', 'Equal'],
+    ['[', '{', 'BracketLeft'],
+    [']', '}', 'BracketRight'],
+    ['\\', '|', 'Backslash'],
+    [';', ':', 'Semicolon'],
+    ["'", '"', 'Quote'],
+    [',', '<', 'Comma'],
+    ['.', '>', 'Period'],
+    ['/', '?', 'Slash'],
+    [' ', ' ', 'Space'],
+];
+
+export const XK_SHIFT_L = 0xffe1;
+const XK_RETURN = 0xff0d;
+const XK_TAB = 0xff09;
+
+const MAP = new Map<string, KeyStroke>();
+for (const [lower, upper, code] of ROWS) {
+    MAP.set(lower, { keysym: lower.charCodeAt(0), code, shift: false });
+    if (!MAP.has(upper)) MAP.set(upper, { keysym: upper.charCodeAt(0), code, shift: true });
+}
+for (let i = 0; i < 26; i++) {
+    const lower = String.fromCharCode(97 + i);
+    const upper = lower.toUpperCase();
+    const code = `Key${upper}`;
+    MAP.set(lower, { keysym: lower.charCodeAt(0), code, shift: false });
+    MAP.set(upper, { keysym: upper.charCodeAt(0), code, shift: true });
+}
+MAP.set('\n', { keysym: XK_RETURN, code: 'Enter', shift: false });
+MAP.set('\t', { keysym: XK_TAB, code: 'Tab', shift: false });
+
+/** Resolves a character to a key stroke; `code` is null for characters that have no US key. */
+export function strokeFor(ch: string): { keysym: number; code: string | null; shift: boolean } {
+    const hit = MAP.get(ch);
+    if (hit) return hit;
+    const cp = ch.codePointAt(0) ?? 0;
+    // Latin-1 keysyms equal their code point; anything else uses the Unicode keysym range.
+    return { keysym: cp < 0x100 ? cp : 0x01000000 | cp, code: null, shift: false };
+}
+
+/** Normalises pasted text: CRLF/CR → LF, drops other control characters. */
+export function normalizeTypedText(text: string): string {
+    return text
+        .replace(/\r\n?/g, '\n')
+        .split('')
+        .filter((c) => c === '\n' || c === '\t' || c >= ' ')
+        .join('');
+}
