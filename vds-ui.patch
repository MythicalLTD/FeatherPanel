diff --git a/frontendv2/src/app/(app)/vds/[id]/snapshots/page.tsx b/frontendv2/src/app/(app)/vds/[id]/snapshots/page.tsx
new file mode 100644
index 00000000..cd4fd39e
--- /dev/null
+++ b/frontendv2/src/app/(app)/vds/[id]/snapshots/page.tsx
@@ -0,0 +1,355 @@
+/*
