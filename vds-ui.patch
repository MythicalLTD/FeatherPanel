diff --git a/backend/storage/migrations/2026-10-24.19.00-vds-iso-library.sql b/backend/storage/migrations/2026-10-24.19.00-vds-iso-library.sql
new file mode 100644
index 00000000..bb57bff1
--- /dev/null
