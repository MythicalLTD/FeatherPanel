diff --git a/frontendv2/src/hooks/useVdsFeatures.ts b/frontendv2/src/hooks/useVdsFeatures.ts
new file mode 100644
index 00000000..c8b9b9ad
--- /dev/null
+++ b/frontendv2/src/hooks/useVdsFeatures.ts
@@ -0,0 +1,76 @@
+/*
+This file is part of FeatherPanel.
+
+Copyright (C) 2025 MythicalSystems Studios
