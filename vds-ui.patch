+        foreach (self::FIREWALL_PRESETS[$preset] as [$proto, $dport, $comment]) {
+            $dupe = array_filter($existing, static fn ($r) => $r['type'] === 'in' && $r['action'] === 'ACCEPT' && $r['proto'] === $proto && $r['dport'] === $dport && $r['source'] === '');
