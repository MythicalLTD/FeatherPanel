diff --git a/backend/app/Controllers/Admin/VmIsosController.php b/backend/app/Controllers/Admin/VmIsosController.php
new file mode 100644
index 00000000..d3072309
--- /dev/null
+++ b/backend/app/Controllers/Admin/VmIsosController.php
@@ -0,0 +1,286 @@
+<?php
+
+/*
+ * This file is part of FeatherPanel.
+ *
+ * Copyright (C) 2025 MythicalSystems Studios
+ * Copyright (C) 2025 FeatherPanel Contributors
+ * Copyright (C) 2025 Cassian Gherman (aka NaysKutzu)
+ *
