# Worker mode: /api/* is served by boot/worker.php, which boots the app once
# and keeps it in memory. Everything else (phpMyAdmin, Roundcube webmail,
# phpPgAdmin, addon PHP files, static files) stays in classic mode.
#
# Pool sizes (sized by caddy/frankenphp-env.sh so they fit FRANKENPHP_MAX_THREADS):
#   FEATHERPANEL_WORKERS              {2 x CPUs}  API worker threads started at boot
#   FEATHERPANEL_WORKER_MAX_THREADS   {4 x CPUs}  the API pool may scale up to this under load
#   FEATHERPANEL_SLOW_WORKERS         {2}         threads for streams and downloads
#   FEATHERPANEL_SLOW_MAX_THREADS     {16}        the slow pool may scale up to this (2 without frankenphp-env.sh)
#   FEATHERPANEL_WORKER_MAX_REQUESTS  {1000}      requests before a worker restarts (0 = never)
# No `watch`: the FrankenPHP file watcher keeps a native watcher thread per
# worker block and has shown runaway CPU and memory; workers already check the
# restart stamp between requests (App\Runtime\WorkerRestart).
php_server {
	root {$FEATHERPANEL_ROOT:/var/www/html}/public

	# See caddy/php-classic.caddyfile.
	try_files {path} {path}/index.php index.php

	# Slow pool: long-lived responses (chatbot streams, downloads) get their
	# own threads, so a handful of them cannot starve the rest of the API.
	worker {
		file {$FEATHERPANEL_ROOT:/var/www/html}/boot/worker.php
		name featherpanel-slow
		num {$FEATHERPANEL_SLOW_WORKERS:2}
		max_threads {$FEATHERPANEL_SLOW_MAX_THREADS:2}
		match /api/user/chatbot/chat/stream /api/user/vds-chatbot/chat/stream /api/user/servers/*/download-file /api/user/servers/*/download-directory /api/user/servers/*/backups/*/download /api/user/webspaces/*/files/download /api/user/webspaces/*/files/download-directory /api/user/webspaces/*/backups/*/download /api/admin/webspaces/*/backups/*/download /api/admin/database-snapshots/*/download /api/client/servers/*/files/download
		env FEATHERPANEL_WORKER_MAX_REQUESTS {$FEATHERPANEL_WORKER_MAX_REQUESTS:1000}
	}

	# Main API pool.
	worker {
		file {$FEATHERPANEL_ROOT:/var/www/html}/boot/worker.php
		name featherpanel-api
		num {$FEATHERPANEL_WORKERS:8}
		# Scale up when requests queue (threads blocked on Wings/HTTP calls),
		# back down after max_idle_time. Sized by caddy/frankenphp-env.sh.
		max_threads {$FEATHERPANEL_WORKER_MAX_THREADS:8}
		match /api/*
		env FEATHERPANEL_WORKER_MAX_REQUESTS {$FEATHERPANEL_WORKER_MAX_REQUESTS:1000}
	}
}
