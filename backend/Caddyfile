# FrankenPHP (Caddy + PHP) - FeatherPanel
# Replaces nginx + php-fpm. PHP runs in-process via php_server.
#
# Environment (all optional, defaults in braces):
#   SERVER_NAME                {:80}            listen address (TLS is left to the reverse proxy)
#   FEATHERPANEL_ROOT          {/var/www/html}  backend directory
#   FEATHERPANEL_PHP_MODE      {worker}         worker | classic, set by init.sh from FRANKENPHP_WORKER (false = classic)
#   PHP_MEMORY_LIMIT           {512M}           memory_limit of web requests (CLI and cron keep their own)
#   FRANKENPHP_MAX_THREADS     {auto}           upper bound of PHP threads, "auto" sizes it from memory_limit
#   FRANKENPHP_MAX_WAIT_TIME   {30s}            a request waiting longer for a free thread gets an error
#   CADDY_ADMIN_ADDRESS        {localhost:2019} Caddy admin API, local only
{
	admin {$CADDY_ADMIN_ADDRESS:localhost:2019}

	frankenphp {
		max_threads {$FRANKENPHP_MAX_THREADS:auto}
		max_wait_time {$FRANKENPHP_MAX_WAIT_TIME:30s}
		php_ini memory_limit {$PHP_MEMORY_LIMIT:512M}
	}
}

{$SERVER_NAME::80} {
	root * {$FEATHERPANEL_ROOT:/var/www/html}/public

	# Never compress Server-Sent Events: compression buffers the stream.
	@compressible not path /api/user/chatbot/chat/stream /api/user/vds-chatbot/chat/stream
	encode @compressible zstd br gzip
	header Server FeatherPanel

	# Write access logs to the shared storage/logs volume so the panel
	# log viewer can display them. Format is plain text to match the
	# other .fplog files read by LogHelper.
	log {
		output file {$FEATHERPANEL_ROOT:/var/www/html}/storage/logs/featherpanel-web.fplog {
			roll_size 50mb
			roll_keep 3
		}
		format console
		level INFO
	}

	# Match nginx: allow larger uploads and long timeouts
	request_body {
		max_size 250MB
	}

	# Block executing PHP in user-writable paths (security)
	@block_php path_regexp ^/(attachments|uploads|storage)/.*\.php$
	handle @block_php {
		respond 403
	}

	# Deny .ht* files
	@dot_ht path_regexp /\.ht
	handle @dot_ht {
		respond 403
	}

	# Static files served from disk. "?" only sets the header when the
	# response has none, so PHP responses keep their own Cache-Control.
	# Translations change when an admin edits them: always revalidate
	# (ETag / Last-Modified make that a cheap 304).
	@translations path /translations/*
	header @translations ?Cache-Control "no-cache"
	@static_assets path /addons/* /components/* /attachments/*
	header @static_assets ?Cache-Control "public, max-age=3600"

	# PHP: classic mode (one request per PHP request) or worker mode
	# (the app stays booted between requests), see caddy/php-*.caddyfile.
	import caddy/php-{$FEATHERPANEL_PHP_MODE:worker}.caddyfile
}
