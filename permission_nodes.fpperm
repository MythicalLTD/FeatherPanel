# FeatherPanel Permission Nodes
# This file defines all permission nodes used throughout the application and client ui!
# You will need the devutils plugin to generate the permission files!
# Format: KEY=value | category | description

# ROOT PERMISSIONS 
ADMIN_ROOT=admin.root | Admin Root | Full access to everything

# Dashboard Permissions
ADMIN_DASHBOARD_VIEW=admin.dashboard.view | Admin Dashboard View | Access to view the admin dashboard

# Users Permissions
ADMIN_USERS_VIEW=admin.users.list | Admin Users | View the users
ADMIN_USERS_CREATE=admin.users.create | Admin Users | Create new users
ADMIN_USERS_EDIT=admin.users.edit | Admin Users | Edit existing users
ADMIN_USERS_DELETE=admin.users.delete | Admin Users | Delete users
ADMIN_USERS_IMPERSONATE=admin.users.impersonate | Admin Users | View the panel as another user (audit logged)

# Banned IPs Permissions
ADMIN_BLOCKED_IPS_VIEW=admin.blocked_ips.view | Admin Banned IPs | View banned panel IPs
ADMIN_BLOCKED_IPS_CREATE=admin.blocked_ips.create | Admin Banned IPs | Ban IPs from panel registration
ADMIN_BLOCKED_IPS_DELETE=admin.blocked_ips.delete | Admin Banned IPs | Remove panel IP bans

