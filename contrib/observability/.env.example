# Copy to .env and adjust.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Name of the docker volume that holds FeatherPanel's storage/logs.
# Find it with: docker volume ls | grep logs
FEATHERPANEL_LOGS_VOLUME=featherpanel_featherpanel_logs
# Value of the "instance" label on file-shipped logs.
FEATHERPANEL_INSTANCE=featherpanel
PROMETHEUS_RETENTION=30d
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALLOY_PORT=12345
GRAFANA_PORT=3000
