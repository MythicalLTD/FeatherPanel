      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "task": "Task",
              "Value #A": "Last run",
              "Value #B": "Succeeded"
            },
            "indexByName": {
              "task": 0,
              "Value #A": 1,
              "Value #B": 2
            }
