          },
          "expr": "sum by (method, route) (rate(featherpanel_http_requests_total{instance=~\"$instance\",method=~\"$method\", route=~\"$route\",status_class=\"5xx\"}[$__range])) / clamp_min(sum by (method, route) (rate(featherpanel_http_requests_total{instance=~\"$instance\",method=~\"$method\", route=~\"$route\"}[$__range])), 1e-9)",
          "format": "table",
          "instant": true,
          "legendFormat": ""
