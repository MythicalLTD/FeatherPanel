                "fieldName": "Value #A",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
            ],
            "type": "exclude",
            "match": "any"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "method": "Method",
              "route": "Route",
              "Value #A": "Requests / s",
              "Value #B": "p95",
              "Value #C": "5xx ratio"
