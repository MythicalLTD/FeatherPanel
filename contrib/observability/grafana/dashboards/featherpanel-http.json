      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(featherpanel_http_requests_total{instance=~\"$instance\",method=~\"$method\", route=~\"$route\",status_class=\"5xx\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(featherpanel_http_requests_total{instance=~\"$instance\",method=~\"$method\", route=~\"$route\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
